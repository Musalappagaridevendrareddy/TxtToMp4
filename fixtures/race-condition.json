      "emphasis": ["indivisible"],
      "emotion": "calm",
      "holdAfterSeconds": 2
    },
    {
      "id": "payoff",
      "narration": "The bug was never in the arithmetic. It was in the gap between the steps.",
      "durationSeconds": 5.5,
      "archetype": "zoom_detail",
      "params": {
        "overview": { "label": "read, add, write" },
        "focus": { "label": "the gap" },
