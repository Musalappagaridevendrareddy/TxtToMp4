# Claude API
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-opus-5
SPEC_MODEL=claude-opus-5
CRITIQUE_MODEL=claude-sonnet-5
GATE_MODEL=claude-haiku-4-5

# TTS engine: kokoro (draft, CPU) | indextts2 (final, GPU)
TTS_ENGINE=kokoro
KOKORO_VOICE=af_heart
INDEXTTS2_MODEL_DIR=

# Infra (docker-compose defaults)
DATABASE_URL=postgres://explainer:explainer@localhost:5432/explainer
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=renders

# Rendering
RENDER_WORK_DIR=./renders
WHISPERX_DEVICE=cpu
WHISPERX_MODEL=base.en
