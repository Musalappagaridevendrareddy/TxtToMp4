# Where the four decision stages run (gate, planner, spec emitter, critique).
#   anthropic     the hosted Claude API (default)
#   openai-compat any local server speaking OpenAI /chat/completions:
#                 Ollama, vLLM, llama.cpp, LM Studio, TGI
# Nothing downstream of the spec uses a model at all, so this only affects
# question -> spec and the critique loop.
LLM_PROVIDER=anthropic

# Only for LLM_PROVIDER=openai-compat.
#   Ollama:    http://localhost:11434/v1
#   vLLM:      http://localhost:8000/v1
#   LM Studio: http://localhost:1234/v1
LLM_BASE_URL=
LLM_API_KEY=
# tools | json_schema | auto. `auto` asks for tool calling and falls back to
# parsing bare JSON out of the reply, which is what smaller local models emit.
# `json_schema` uses constrained decoding and is often the most reliable local
# option; `tools` is strict and will not salvage.
LLM_STRUCTURED_OUTPUT=auto
# Set to 1 only if CRITIQUE_MODEL can actually see images. Left at 0, the
# critique stage refuses rather than silently reviewing frames it cannot read.
LLM_VISION=0

# Claude API. Required unless LLM_PROVIDER=openai-compat.
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-opus-5
SPEC_MODEL=claude-opus-5
CRITIQUE_MODEL=claude-sonnet-5
GATE_MODEL=claude-haiku-4-5

# TTS engine: kokoro (draft, CPU) | indextts2 (final, GPU)
TTS_ENGINE=kokoro
KOKORO_VOICE=af_heart
INDEXTTS2_MODEL_DIR=

# Infra (docker-compose defaults)
DATABASE_URL=postgres://explainer:explainer@localhost:5432/explainer
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=renders

# Rendering
RENDER_WORK_DIR=./renders
WHISPERX_DEVICE=cpu
WHISPERX_MODEL=base.en

# --- Uploads / OCR -------------------------------------------------------
# Uploaded documents and photos are extracted to text and passed to the
# planner as a SOURCE alongside the question — they never replace it.
#   auto (default)  text layer first, then the best available OCR engine
#   rapidocr        Apache-2.0, ONNXRuntime, CPU, aarch64-safe
#   tesseract       Apache-2.0, needs the tesseract binary
#   vlm             a vision model on LLM_BASE_URL (best quality)
OCR_ENGINE=auto
# Vision model used when OCR_ENGINE=vlm. Falls back to CRITIQUE_MODEL.
OCR_VLM_MODEL=
# Render scale when a scanned PDF must be rasterised before OCR.
OCR_RASTER_SCALE=2.0
